---
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import MobileMenuOverlay from "../components/MobileMenuOverlay.astro";
import { PERSONAL_INFO } from "../constants";
import { ClientRouter } from "astro:transitions";

interface Props {
	title?: string;
	description?: string;
	ogImage?: string;
}

const defaultDescription =
	`Portfolio de ${PERSONAL_INFO.fullName} | ${PERSONAL_INFO.jobTitle} en ${PERSONAL_INFO.location.detailed}. Desarrollo de aplicaciones de escritorio y web.`;
const siteName = PERSONAL_INFO.fullName;

const {
	title = `${PERSONAL_INFO.fullName} | ${PERSONAL_INFO.jobTitle}`,
	description = defaultDescription,
	ogImage = "/og-image.png",
} = Astro.props;

if (!Astro.site) {
	throw new Error("Crítico: Define la propiedad 'site' en astro.config.mjs para que el SEO funcione.");
}

const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
const ogImageUrl = ogImage.startsWith("http") ? ogImage : new URL(ogImage, Astro.site).href;
const ogType = Astro.url.pathname === "/" ? "profile" : "website";
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<script is:inline>
			const getTheme = () => {
				if (
					typeof localStorage !== "undefined" &&
					localStorage.getItem("theme")
				) {
					return localStorage.getItem("theme");
				}
				if (window.matchMedia("(prefers-color-scheme: dark)").matches) {
					return "dark";
				}
				return "light";
			};

			const applyTheme = () => {
				const theme = getTheme();
				if (theme === "dark") {
					document.documentElement.classList.add("dark");
				} else {
					document.documentElement.classList.remove("dark");
				}
			};

			applyTheme();
			document.addEventListener("astro:after-swap", applyTheme);
		</script>
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/logo-dark.svg" media="(prefers-color-scheme: light)" />
		<link rel="icon" type="image/svg+xml" href="/logo-white.svg" media="(prefers-color-scheme: dark)" />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<meta name="generator" content={Astro.generator} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&family=JetBrains+Mono:ital,wght@0,400..800;1,400..800&display=swap"
			rel="stylesheet"
		/>
		<ClientRouter />

		<!-- SEO -->
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalUrl} />
		<meta name="robots" content="index, follow" />

		<!-- Open Graph -->
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content={ogType} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:site_name" content={siteName} />
		<meta property="og:image" content={ogImageUrl} />
		<meta property="og:image:alt" content={title} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:locale" content="es_ES" />

		<!-- Twitter / X -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageUrl} />
	</head>
	<body
		class="relative antialiased min-h-screen flex flex-col bg-background text-primary selection:bg-foreground selection:text-background"
	>
		<!-- Grilla arquitectónica monocromática de fondo (fija y sutil en ambos temas) -->
		<!-- [Convención Tailwind v4] Se usan valores arbitrarios para linear-gradient, bg-size y mask-image para el tramado técnico -->
		<div
			class="pointer-events-none fixed inset-0 -z-10 bg-[linear-gradient(to_right,var(--color-border)_1px,transparent_1px),linear-gradient(to_bottom,var(--color-border)_1px,transparent_1px)] bg-[size:4rem_4rem] [mask-image:radial-gradient(ellipse_80%_65%_at_50%_20%,#000_40%,transparent_100%)] opacity-35 dark:opacity-25"
			aria-hidden="true"
		></div>

		<Navbar />
		<!-- Overlay del menú móvil (fuera del header para z-index correcto) -->
		<MobileMenuOverlay />
		<div class="grow">
			<slot />
		</div>
		<Footer />
	</body>
</html>

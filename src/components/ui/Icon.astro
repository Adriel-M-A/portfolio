---
interface Props {
  name: 'github' | 'linkedin' | 'home' | 'mail' | 'lock' | 'external-link' | 'sun' | 'moon' | 'menu' | 'x' | 'terminal' | 'database' | 'wrench' | 'graduation-cap' | 'copy' | 'check';
  class?: string;
  size?: number;
}

const { name, class: className = '', size = 24 } = Astro.props;
---

<span aria-hidden="true" class="contents">

---
interface Props {
  size?: 'sm' | 'md' | 'lg';
  class?: string;
  variant?: 'default' | 'active';
}

const { size = 'md', class: className = '', variant = 'default' } = Astro.props;

const baseStyles = "inline-flex items-center font-mono border transition-colors duration-200 cursor-default";

const variants = {
  default: "border-border text-muted-foreground bg-surface/60 hover:bg-surface hover:text-foreground hover:border-foreground/30",
  active: "border-foreground/30 text-foreground bg-surface font-medium",
};

const sizes = {
  sm: "text-xs px-2 py-0.5",
  md: "text-xs px-2.5 py-1",
  lg: "text-xs md:text-sm px-3 py-1.5",
};

const classes = `${baseStyles} ${variants[variant]} ${sizes[size]} ${className}`;
---

<span class={classes}>
  <slot />
</span>

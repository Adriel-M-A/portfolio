---
import Icon from "./ui/Icon.astro";
import { PERSONAL_INFO } from "../constants";

const currentYear = new Date().getFullYear();
---

<footer class="w-full border-t border-border bg-background py-6 mt-12">
  <div
    class="max-w-6xl mx-auto px-6 flex flex-col md:flex-row items-center justify-between gap-4 text-xs font-mono text-muted-foreground"
  >
    <!-- Estado y Autoría (Izquierda) -->
    <div class="flex flex-wrap items-center justify-center md:justify-start gap-3">
      <span class="inline-flex items-center gap-1.5 px-2 py-0.5 border border-border bg-surface text-foreground select-none">
        <span class="size-2 bg-foreground inline-block" aria-hidden="true"></span>
        <span>status: disponible</span>
      </span>
      <span>
        &copy; {currentYear} {PERSONAL_INFO.fullName}
      </span>
      <span class="hidden sm:inline text-border select-none" aria-hidden="true">//</span>
      <span class="hidden sm:inline">
        {PERSONAL_INFO.jobTitle}
      </span>
    </div>

    <!-- Enlaces Rápidos y Metadatos de Build (Derecha) -->
    <div class="flex flex-wrap items-center justify-center md:justify-end gap-4">
      <a
        href={PERSONAL_INFO.github}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 py-1 text-muted-foreground hover:text-foreground transition-colors duration-200 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
        aria-label="GitHub de Adriel Montes"
      >
        <Icon name="github" size={15} />
        <span>GitHub</span>
      </a>

      <a
        href={PERSONAL_INFO.linkedin}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 py-1 text-muted-foreground hover:text-foreground transition-colors duration-200 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
        aria-label="LinkedIn de Adriel Montes"
      >
        <Icon name="linkedin" size={15} />
        <span>LinkedIn</span>
      </a>

      <a
        href={`mailto:${PERSONAL_INFO.email}`}
        class="inline-flex items-center gap-1.5 py-1 text-muted-foreground hover:text-foreground transition-colors duration-200 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
        aria-label="Escribir correo a Adriel Montes"
      >
        <Icon name="mail" size={15} />
        <span>Email</span>
      </a>

      <span class="hidden sm:inline text-border select-none" aria-hidden="true">//</span>

      <span class="px-2 py-0.5 border border-border bg-surface text-xs uppercase tracking-wider select-none text-muted-foreground">
        Astro 6 &middot; SSG
      </span>
    </div>
  </div>
</footer>

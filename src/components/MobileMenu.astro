---
// Menú móvil (Botón disparador de apertura con área táctil accesible >= 44x44px)
import Icon from "./ui/Icon.astro";
---

<!-- Botón hamburguesa (visible solo en mobile) -->
<button
  id="mobile-menu-btn"
  class="md:hidden min-h-[44px] min-w-[44px] p-2.5 border border-border bg-surface/70 hover:bg-surface hover:border-foreground/40 text-foreground flex items-center justify-center transition-colors cursor-pointer focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
  aria-label="Abrir menú de navegación"
  aria-expanded="false"
  aria-controls="mobile-menu-overlay"
  type="button"
>
  <!-- Icono hamburguesa -->
  <Icon name="menu" size={20} />
</button>

<script>
  import { initMobileMenu } from '../scripts/mobileMenu';
  initMobileMenu();
</script>

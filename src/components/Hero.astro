---
import Icon from "./ui/Icon.astro";
import Button from "./ui/Button.astro";
import { PERSONAL_INFO } from "../constants";
---

<section
  class="min-h-[60vh] w-full flex flex-col justify-center py-16 md:py-24"
>
  <div class="max-w-3xl flex flex-col items-start gap-6">
    <!-- Presentación principal -->
    <div class="space-y-3">
      <h1 class="tracking-tight">{PERSONAL_INFO.fullName}</h1>
      <p class="text-xl md:text-2xl text-muted-foreground font-medium font-display">
        {PERSONAL_INFO.jobTitle}
      </p>
      <p class="text-base text-muted-foreground max-w-2xl pt-2 leading-relaxed">
        Desarrollador de software especializado en aplicaciones de escritorio y web. Construyo sistemas de principio a fin, desde el relevamiento funcional y el modelado de bases de datos hasta el despliegue de herramientas locales, arquitecturas en red e interfaces modernas que resuelven problemas operativos reales.
      </p>
    </div>

    <!-- Acciones directas -->
    <div class="flex flex-wrap gap-3 pt-1">
      <Button href="/proyectos" variant="primary" size="lg">
        Ver proyectos &rarr;
      </Button>
      <Button href="/contacto" variant="outline" size="lg">
        Contacto
      </Button>
    </div>

    <!-- Enlaces profesionales -->
    <div class="flex items-center gap-5 pt-1 font-mono text-xs text-muted-foreground">
      <a
        href={PERSONAL_INFO.github}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 text-muted-foreground hover:text-foreground transition-colors duration-200 py-1 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
        aria-label="GitHub"
      >
        <Icon name="github" size={18} />
        <span>Adriel-M-A</span>
      </a>
      <span class="text-border select-none" aria-hidden="true">/</span>
      <a
        href={PERSONAL_INFO.linkedin}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 text-muted-foreground hover:text-foreground transition-colors duration-200 py-1 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
        aria-label="LinkedIn"
      >
        <Icon name="linkedin" size={18} />
        <span>adriel-agustin-montes</span>
      </a>
    </div>
  </div>
</section>

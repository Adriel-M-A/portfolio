---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Icon from './ui/Icon.astro';
import Badge from './ui/Badge.astro';
import Button from './ui/Button.astro';

interface Props {
  proyecto: CollectionEntry<'proyectos'>;
  headingLevel?: 'h2' | 'h3';
}

const { proyecto, headingLevel = 'h2' } = Astro.props;
const Heading = headingLevel;
const { data, id } = proyecto;
const { title, description, tecnologias, github, demo, cover, coverAlt, categoria } = data;

// Obtener las tecnologías representativas manteniendo orden limpio
const allTechs = tecnologias ? [
  ...(tecnologias.frontend ?? []),
  ...(tecnologias.backend ?? []),
  ...(tecnologias.herramientas ?? []),
] : [];
const cardTechs = allTechs.slice(0, 4);
---

<article 
  class="group bg-card border border-border flex flex-col transition-all duration-300 ease-out hover:border-foreground/50 project-card"
  data-category={categoria}
>
  <!-- Imagen de portada -->
  <a
    href={`/proyectos/${id}`}
    tabindex="-1"
    aria-hidden="true"
    class="relative aspect-video w-full bg-surface border-b border-border flex items-center justify-center text-center overflow-hidden block"
  >
    {cover ? (
      <Image
        src={cover}
        alt={coverAlt || `Portada del proyecto ${title}`}
        width={800}
        height={450}
        class="w-full h-full object-cover object-top group-hover:scale-[1.03] transition-transform duration-500 ease-out"
      />
    ) : (
      <span class="font-mono text-sm text-muted-foreground p-6">{title}</span>
    )}
  </a>

  <div class="p-5 flex flex-col grow gap-4">
    <!-- Tecnologías en su propio bloque de ancho completo -->
    <div class="flex flex-wrap gap-1.5">
      {cardTechs.map((tech) => (
        <Badge size="sm">
          {tech}
        </Badge>
      ))}
    </div>

    <!-- Título y Descripción -->
    <div>
      <a
        href={`/proyectos/${id}`}
        class="inline-block focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring group-hover:underline decoration-foreground/50 underline-offset-4 mb-2"
      >
        <Heading class="text-base md:text-lg font-semibold text-foreground">{title}</Heading>
      </a>
      <p class="text-sm text-muted-foreground leading-relaxed line-clamp-3">
        {description}
      </p>
    </div>

    <!-- Pie de tarjeta dedicado para enlaces y acción principal -->
    <div class="flex items-center justify-between gap-4 mt-auto pt-3 border-t border-border/60">
      <div class="flex items-center gap-3 font-mono text-xs text-muted-foreground">
        {github && github.length > 0 && github.toLowerCase() !== 'privado' && (
          <a
            href={github}
            target="_blank"
            rel="noopener noreferrer"
            class="text-foreground hover:text-muted-foreground transition-colors inline-flex items-center gap-1.5 py-1 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
            aria-label={`Repositorio público de ${title}`}
          >
            <Icon name="github" size={14} />
            <span>repo</span>
          </a>
        )}
        {demo && demo.length > 0 && (
          <a
            href={demo}
            target="_blank"
            rel="noopener noreferrer"
            class="text-foreground hover:text-muted-foreground transition-colors inline-flex items-center gap-1.5 py-1 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
            aria-label={`Demo online de ${title}`}
          >
            <Icon name="external-link" size={14} />
            <span>demo</span>
          </a>
        )}
      </div>

      <Button href={`/proyectos/${id}`} size="sm" variant="outline" aria-label={`Ver detalles del proyecto ${title}`}>
        Ver ficha &rarr;
      </Button>
    </div>
  </div>
</article>

---
// Overlay fullscreen del menú móvil, renderizado fuera del <header>
// para evitar problemas de stacking context
import ThemeToggle from "./ThemeToggle.astro";
import Icon from "./ui/Icon.astro";
import { PERSONAL_INFO } from "../constants";

const pathname = Astro.url.pathname;
const currentPath = pathname === "/" ? "/" : pathname.replace(/\/$/, "");

const links = [
  { href: "/", label: "Inicio", index: "01" },
  { href: "/sobreMi", label: "Sobre mí", index: "02" },
  { href: "/proyectos", label: "Proyectos", index: "03" },
  { href: "/contacto", label: "Contacto", index: "04" },
];
---

<!-- Contenedor del overlay fuera del header para z-index correcto -->
<div
  id="mobile-menu-overlay"
  class="fixed inset-0 z-overlay pointer-events-none md:hidden"
  aria-hidden="true"
  role="dialog"
  aria-modal="true"
  aria-label="Menú de navegación"
>
  <!-- Backdrop oscuro -->
  <div
    data-menu-backdrop
    class="absolute inset-0 bg-black/75 opacity-0 transition-opacity duration-300"
  >
  </div>

  <!-- Panel del menú (desliza desde la derecha, cubre toda la pantalla) -->
  <div
    data-menu-panel
    class="absolute inset-0 bg-background flex flex-col translate-x-full transition-transform duration-300 ease-in-out"
  >
    <!-- Cabecera del overlay: logo a la izquierda, etiqueta técnica y botón X -->
    <div
      class="max-w-6xl w-full mx-auto px-6 h-16 flex items-center justify-between border-b border-border bg-surface/50"
    >
      <div class="flex items-center gap-3">
        <a href="/" class="flex items-center gap-2" aria-label="Ir al inicio">
          <img
            src="/logo-dark.svg"
            alt={PERSONAL_INFO.fullName}
            width="46"
            class="h-6 w-auto block dark:hidden"
          />
          <img
            src="/logo-white.svg"
            alt={PERSONAL_INFO.fullName}
            width="46"
            class="h-6 w-auto hidden dark:block"
          />
        </a>
        <span class="font-mono text-xs text-muted-foreground border border-border px-2 py-0.5 bg-background select-none">
          menu // nav.sh
        </span>
      </div>

      <button
        id="mobile-menu-close"
        class="min-h-[44px] min-w-[44px] p-2.5 border border-border bg-background hover:bg-surface text-foreground flex items-center justify-center transition-colors cursor-pointer focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
        aria-label="Cerrar menú"
        type="button"
      >
        <!-- Icono X -->
        <Icon name="x" size={20} />
      </button>
    </div>

    <!-- Links de navegación apilados verticalmente con formato de terminal -->
    <nav class="flex flex-col gap-2.5 px-6 mt-8" aria-label="Navegación móvil">
      {
        links.map((link) => {
          const isActive = currentPath === link.href || (link.href !== "/" && currentPath.startsWith(link.href));
          return (
            <a
              href={link.href}
              class:list={[
                "font-mono text-sm py-3.5 px-4 transition-colors duration-150 border flex items-center justify-between min-h-12",
                isActive
                  ? "text-foreground font-semibold bg-surface border-foreground/40"
                  : "text-muted-foreground hover:text-foreground bg-card border-border hover:border-foreground/20",
              ]}
              aria-current={isActive ? "page" : undefined}
            >
              <span class="flex items-center gap-2.5">
                {isActive && (
                  <span class="size-1.5 bg-foreground inline-block shrink-0" aria-hidden="true" />
                )}
                <span class="text-xs text-muted-foreground/60 select-none">{link.index} //</span>
                <span>{link.label}</span>
              </span>
              <span
                class:list={[
                  "text-xs font-mono",
                  isActive ? "text-foreground font-semibold" : "text-muted-foreground/50",
                ]}
                aria-hidden="true"
              >
                &rarr;
              </span>
            </a>
          );
        })
      }
    </nav>

    <!-- Barra inferior con canales de contacto y selector de tema -->
    <div
      class="mt-auto border-t border-border bg-surface/40 p-6 flex flex-col gap-5 pb-[max(1.5rem,env(safe-area-inset-bottom))]"
    >
      <div class="flex items-center justify-between gap-4 font-mono text-xs text-muted-foreground">
        <a
          href={PERSONAL_INFO.github}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 py-1 text-muted-foreground hover:text-foreground transition-colors"
          aria-label="GitHub"
        >
          <Icon name="github" size={16} />
          <span>GitHub</span>
        </a>
        <a
          href={PERSONAL_INFO.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 py-1 text-muted-foreground hover:text-foreground transition-colors"
          aria-label="LinkedIn"
        >
          <Icon name="linkedin" size={16} />
          <span>LinkedIn</span>
        </a>
        <a
          href={`mailto:${PERSONAL_INFO.email}`}
          class="inline-flex items-center gap-1.5 py-1 text-muted-foreground hover:text-foreground transition-colors"
          aria-label="Enviar email"
        >
          <Icon name="mail" size={16} />
          <span>Email</span>
        </a>
      </div>

      <div class="flex items-center justify-between border-t border-border/70 pt-4 font-mono text-xs text-muted-foreground">
        <span>Alternar tema:</span>
        <div class="border border-border bg-background p-1 flex items-center">
          <ThemeToggle />
        </div>
      </div>
    </div>
  </div>
</div>

---
import Layout from '../layouts/Layout.astro';
import Badge from '../components/ui/Badge.astro';
import Icon from '../components/ui/Icon.astro';
import { getCollection, render } from 'astro:content';
import { TECHNOLOGIES_BY_CATEGORY } from '../constants/technologies';
import { PERSONAL_INFO } from '../constants';

const experienciaEntries = await getCollection('experiencia');
experienciaEntries.sort((a, b) => a.id.localeCompare(b.id));

const {
  frontend: sortedFrontend,
  backend: sortedBackend,
  herramientas: sortedHerramientas
} = TECHNOLOGIES_BY_CATEGORY;
---

<Layout title={`Sobre mí | ${PERSONAL_INFO.fullName}`}>
	<main class="max-w-5xl mx-auto px-6 py-16">
		<!-- Perfil Profesional -->
		<section class="portfolio-section">
			<h1 class="mb-8">Sobre mí</h1>
			<div class="max-w-3xl flex flex-col gap-5 text-muted-foreground leading-relaxed">
				<p>
					Soy desarrollador de software y recibido como <strong class="text-foreground font-semibold">{PERSONAL_INFO.jobTitle}</strong> en la Universidad Nacional de la Patagonia San Juan Bosco. Me dedico a construir aplicaciones que resuelven problemas operativos concretos, abarcando sistemas de gestión interna en red, puntos de venta locales, herramientas de procesamiento por lotes y aplicaciones web.
				</p>
				<p>
					Trabajo de principio a fin en el ciclo de vida del software. Relevo requerimientos directamente con el cliente o las áreas operativas, modelo la base de datos relacional, diseño la arquitectura en capas, programo la solución, la despliego en los equipos de trabajo y capacito a los usuarios finales.
				</p>
			</div>
		</section>

		<!-- Experiencia Laboral -->
		<section class="portfolio-section">
			<h2 class="mb-8">Experiencia laboral</h2>

			<div class="relative pl-5 md:pl-8 flex flex-col gap-10 ml-1 md:ml-4">
				{
					experienciaEntries.map(async (entry) => {
						const { Content } = await render(entry);
						const { rol, empresa, nombreCompleto, desde, hasta, tipo } = entry.data;
						return (
							<article class="relative group bg-card border border-border p-5 md:p-6 transition-colors duration-200 hover:border-foreground/50">
								<!-- Segmento de línea de tiempo -->
								<div class="absolute -left-5 md:-left-8 -top-5 -bottom-5 w-px bg-border group-first:top-4 group-last:bottom-auto group-last:h-4" />
								
								<!-- Nodo de la línea de tiempo (cuadrado técnico) -->
								<div class="absolute left-[-26px] md:left-[-38px] top-6 w-3 h-3 bg-background border-2 border-foreground/40 group-hover:bg-foreground group-hover:border-foreground transition-colors" />
								
								<div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-2">
									<div>
										<h3 class="text-base md:text-lg font-semibold text-foreground">
											{rol}
										</h3>
										<p class="font-mono text-xs md:text-sm text-muted-foreground mt-1">
											{nombreCompleto || empresa}
										</p>
									</div>
									<div class="flex items-center gap-2 font-mono text-xs text-muted-foreground shrink-0">
										<span class="text-foreground font-semibold">{desde} &rarr; {hasta}</span>
										{tipo && tipo.length > 0 && (
											<span class="uppercase tracking-wider text-[11px] px-2 py-0.5 border border-border bg-surface text-foreground">
												{tipo}
											</span>
										)}
									</div>
								</div>

								<div class="experiencia-content mt-4 pt-4 border-t border-border/60 text-muted-foreground leading-relaxed">
									<Content />
								</div>
							</article>
						);
					})
				}
			</div>
		</section>

		<!-- Stack Tecnológico -->
		<section class="portfolio-section">
			<h2 class="mb-8">Stack tecnológico</h2>
			
			<div class="grid grid-cols-1 md:grid-cols-3 gap-6">
				<!-- Frontend -->
				<div class="bg-card border border-border p-5 flex flex-col gap-4 transition-colors duration-200 hover:border-foreground/50">
					<div class="flex items-center gap-2.5 text-foreground">
						<Icon name="terminal" size={18} />
						<h3 class="text-base font-semibold">Frontend e Interfaces</h3>
					</div>
					<div class="flex flex-wrap gap-2">
						{sortedFrontend.map((tech) => (
							<Badge size="md">
								{tech}
							</Badge>
						))}
					</div>
				</div>

				<!-- Backend -->
				<div class="bg-card border border-border p-5 flex flex-col gap-4 transition-colors duration-200 hover:border-foreground/50">
					<div class="flex items-center gap-2.5 text-foreground">
						<Icon name="database" size={18} />
						<h3 class="text-base font-semibold">Backend y Bases de Datos</h3>
					</div>
					<div class="flex flex-wrap gap-2">
						{sortedBackend.map((tech) => (
							<Badge size="md">
								{tech}
							</Badge>
						))}
					</div>
				</div>

				<!-- Herramientas -->
				<div class="bg-card border border-border p-5 flex flex-col gap-4 transition-colors duration-200 hover:border-foreground/50">
					<div class="flex items-center gap-2.5 text-foreground">
						<Icon name="wrench" size={18} />
						<h3 class="text-base font-semibold">Entornos y Herramientas</h3>
					</div>
					<div class="flex flex-wrap gap-2">
						{sortedHerramientas.map((tech) => (
							<Badge size="md">
								{tech}
							</Badge>
						))}
					</div>
				</div>
			</div>
		</section>

		<!-- Educación y Certificaciones -->
		<section class="portfolio-section">
			<h2 class="mb-8">Educación y certificaciones</h2>
			<div class="grid grid-cols-1 md:grid-cols-3 gap-6">
				<!-- Título Universitario -->
				<div class="bg-card border border-border p-5 relative overflow-hidden flex flex-col justify-between transition-colors duration-200 hover:border-foreground/50">
					<div>
						<div class="flex items-center justify-between gap-2 font-mono text-xs text-muted-foreground mb-3">
							<span class="uppercase tracking-wider">Título Universitario</span>
							<span class="text-foreground font-medium">2021 &rarr; 2026</span>
						</div>
						<h3 class="text-base font-semibold mb-1">
							{PERSONAL_INFO.jobTitle}
						</h3>
						<p class="text-sm text-muted-foreground">
							Universidad Nacional de la Patagonia San Juan Bosco
						</p>
					</div>
					<Icon name="graduation-cap" size={56} class="absolute right-4 bottom-3 text-muted-foreground/10 pointer-events-none" />
				</div>

				<!-- Certificación SQL -->
				<div class="bg-card border border-border p-5 flex flex-col justify-between transition-colors duration-200 hover:border-foreground/50">
					<div>
						<div class="flex items-center justify-between gap-2 font-mono text-xs text-muted-foreground mb-3">
							<span class="uppercase tracking-wider">Certificación Técnica</span>
							<span class="text-foreground font-medium">2026</span>
						</div>
						<div class="flex items-start justify-between gap-3">
							<div>
								<h3 class="text-base font-semibold mb-1">Curso Intensivo de SQL</h3>
								<p class="text-sm text-muted-foreground">
									Miguel Ángel Durán (midudev). Consultas, uniones, agregación y funciones de ventana (112 ejercicios y 7 exámenes).
								</p>
							</div>
							<a
								href="https://certificados.midudev.com/baabe355-c948-40d0-9e9e-c6d3ddc90d0a.pdf"
								target="_blank"
								rel="noopener noreferrer"
								class="font-mono text-xs px-2.5 py-1 border border-border bg-surface hover:border-foreground/50 text-foreground inline-flex items-center gap-1 shrink-0 transition-colors mt-0.5"
								aria-label="Ver certificado SQL en PDF"
							>
								<span>PDF</span>
								<Icon name="external-link" size={12} />
							</a>
						</div>
					</div>
				</div>

				<!-- Secundaria Técnica -->
				<div class="bg-card border border-border p-5 flex flex-col justify-between transition-colors duration-200 hover:border-foreground/50">
					<div>
						<div class="flex items-center justify-between gap-2 font-mono text-xs text-muted-foreground mb-3">
							<span class="uppercase tracking-wider">Secundaria Técnica</span>
							<span class="text-foreground font-medium">2008 &rarr; 2015</span>
						</div>
						<h3 class="text-base font-semibold mb-1">
							Técnico en Equipos e Instalaciones Electromecánicas
						</h3>
						<p class="text-sm text-muted-foreground">
							E.S.E.T.P. N° 748 (ex-ENET Teniente Coronel Luis Piedrabuena)
						</p>
					</div>
				</div>
			</div>
		</section>
	</main>
</Layout>

<style>
  .experiencia-content :global(ul) {
    list-style-type: none;
    margin-left: 0;
    padding-left: 0;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }
  
  .experiencia-content :global(li) {
    position: relative;
    padding-left: 1.25rem;
    font-size: 0.875rem;
    color: var(--color-muted-foreground);
    line-height: 1.625;
  }

  .experiencia-content :global(li::before) {
    content: ">";
    position: absolute;
    left: 0;
    top: 0;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-foreground);
    opacity: 0.7;
  }
  
  .experiencia-content :global(p) {
    font-size: 0.875rem;
    color: var(--color-muted-foreground);
    line-height: 1.625;
    margin-bottom: 0.5rem;
  }
</style>

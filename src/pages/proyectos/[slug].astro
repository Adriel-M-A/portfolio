---
import Layout from "../../layouts/Layout.astro";
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import Icon from "../../components/ui/Icon.astro";
import Badge from "../../components/ui/Badge.astro";
import Button from "../../components/ui/Button.astro";
import SchemaProjectLD from "../../components/SchemaProjectLD.astro";
import { PERSONAL_INFO } from "../../constants";
import 'photoswipe/dist/photoswipe.css';

export async function getStaticPaths() {
	const proyectos = await getCollection("proyectos");
	return proyectos.map((proyecto) => ({
		params: { slug: proyecto.id },
		props: { proyecto },
	}));
}

const { proyecto } = Astro.props;
const { Content } = await render(proyecto);
const {
	title,
	description,
	tecnologias: tecnologiasObj,
	github,
	demo,
	cover,
	coverAlt,
	imagenes,
	imagenesAlt,
} = proyecto.data;
const tecnologias = tecnologiasObj
	? [
			...tecnologiasObj.frontend,
			...tecnologiasObj.backend,
			...tecnologiasObj.herramientas,
		]
	: [];
---

<Layout
	title={`${title} | ${PERSONAL_INFO.fullName}`}
	description={description}
	ogImage={cover?.src}
>
	<SchemaProjectLD
		name={title}
		description={description}
		authorName={PERSONAL_INFO.fullName}
		authorUrl={Astro.site?.toString() ?? PERSONAL_INFO.domain}
		repoUrl={github}
		demoUrl={demo}
	/>
	<main id="project-gallery-group" class="max-w-4xl mx-auto px-6 py-16 md:py-24">
		<!-- Barra de navegación superior -->
		<div class="flex items-center mb-10 pb-4 border-b border-border">
			<a
				href="/proyectos"
				class="inline-flex items-center gap-2 font-mono text-xs md:text-sm text-muted-foreground hover:text-foreground transition-colors duration-200 py-1 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
			>
				<span aria-hidden="true">&larr;</span> Volver a proyectos
			</a>
		</div>

		<!-- Cabecera -->
		<header class="mb-12">
			<h1 class="mb-4">
				{title}
			</h1>
			<p
				class="text-base text-muted-foreground leading-relaxed mb-6 max-w-3xl"
			>
				{description}
			</p>

			<div class="flex flex-wrap items-center gap-2 mb-8">
				{
					tecnologias?.map((tech: string) => (
						<Badge size="md">{tech}</Badge>
					))
				}
			</div>

			<div class="flex flex-wrap items-center gap-4">
				{
					github &&
						github.length > 0 &&
						(github.toLowerCase() === "privado" ? (
							<span class="inline-flex items-center gap-2 bg-surface border border-border px-4 py-2 font-mono text-xs md:text-sm font-medium text-muted-foreground cursor-not-allowed">
								<Icon name="lock" class="w-4 h-4" />
								Repositorio privado (Uso interno)
							</span>
						) : (
							<Button
								href={github}
								target="_blank"
								rel="noopener noreferrer"
								variant="secondary"
								size="md"
								class="gap-2"
							>
								<Icon name="github" size={16} />
								Ver repositorio
							</Button>
						))
				}
				{
					demo && demo.length > 0 && (
						<Button
							href={demo}
							target="_blank"
							rel="noopener noreferrer"
							variant="primary"
							size="md"
							class="gap-2"
						>
							<Icon name="external-link" class="w-4 h-4" />
							Ver Demo
						</Button>
					)
				}
			</div>
		</header>

		<!-- Imagen Principal -->
		<div class="mb-16">
			{
				cover ? (
					<figure class="bg-card border border-border overflow-hidden group">
						<div class="w-full aspect-video bg-surface overflow-hidden">
							<a
								href={cover.src}
								data-pswp-width={cover.width}
								data-pswp-height={cover.height}
								target="_blank"
								class="block w-full h-full focus-visible:outline-2 focus-visible:outline-offset-[-2px] focus-visible:outline-ring"
							>
								<Image
									src={cover}
									alt={
										coverAlt || `Portada del proyecto ${title}`
									}
									width={1200}
									height={675}
									fetchpriority="high"
									loading="eager"
									class="w-full h-full object-cover object-top cursor-zoom-in transition-transform duration-500 ease-out group-hover:scale-[1.01]"
								/>
							</a>
						</div>

						{coverAlt && (
							<figcaption class="px-4 py-2.5 border-t border-border bg-surface/50 font-mono text-xs text-muted-foreground">
								{coverAlt}
							</figcaption>
						)}
					</figure>
				) : (
					<div class="w-full aspect-video bg-surface border border-border flex items-center justify-center">
						<span class="font-mono text-lg text-muted-foreground font-medium">
							{title}
						</span>
					</div>
				)
			}
		</div>

		<!-- Contenido Markdown (README / Especificación) -->
		<div
			class="text-muted-foreground leading-relaxed text-base prose-content mb-16"
		>
			<Content />
		</div>

		<!-- Galería de imágenes -->
		{
			imagenes && imagenes.length > 0 && (
				<section class="portfolio-section">
					<h2 class="mb-8">Galería de capturas</h2>

					<div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
						{imagenes.map((img, index: number) => {
							const altText =
								imagenesAlt?.[index] ||
								`Captura ${index + 1} de ${title}`;

							return (
								<figure class="bg-card border border-border flex flex-col overflow-hidden group transition-colors duration-200 hover:border-foreground/50">
									<div class="aspect-video bg-surface overflow-hidden">
										<a
											href={img.src}
											data-pswp-width={img.width}
											data-pswp-height={img.height}
											target="_blank"
											class="block w-full h-full focus-visible:outline-2 focus-visible:outline-offset-[-2px] focus-visible:outline-ring"
										>
											<Image
												src={img}
												alt={altText}
												width={800}
												height={450}
												class="w-full h-full object-cover object-top transition-transform duration-500 ease-out group-hover:scale-[1.03] cursor-zoom-in"
											/>
										</a>
									</div>

									<figcaption class="p-3.5 border-t border-border bg-card font-mono text-xs text-muted-foreground leading-relaxed grow">
										{altText}
									</figcaption>
								</figure>
							);
						})}
					</div>
				</section>
			)
		}

		<script>
			import { initLightbox } from "../../scripts/lightbox";
			initLightbox();
		</script>
	</main>
</Layout>
